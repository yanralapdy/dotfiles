#!/usr/bin/env bash
set -euo pipefail

# Control Android device with Mac mouse & keyboard via scrcpy UHID mode.
# Safe for public dotfiles: contains no hardcoded IPs, ports, or secrets.
#
# Usage:
#   phone                       # Auto-discover/connect phone & start mouse/keyboard sharing (no video)
#   phone -v / --video          # Also show Android screen video in a window on Mac
#   phone -l / --landscape      # Force phone into landscape (even portrait-only apps) & restore on exit
#   phone -rl / --rev-landscape # Force reverse-landscape (270 deg) & restore on exit
#   phone -p / --portrait       # Force portrait (0 deg)
#   phone pair                  # Auto-discover pairing IP:PORT via mDNS & prompt for 6-digit code
#   phone 192.168.1.50:41234    # Connect to explicit IP:PORT (if router blocks mDNS)
#   phone -w                    # Pass any extra flags (like -w / --stay-awake) to scrcpy

adb start-server >/dev/null 2>&1

# Print IP:PORT of an mDNS service. adb's own mDNS often finds nothing on macOS,
# so fall back to the system resolver (dns-sd), which does see the phone.
find_service() {
    local svc="$1" target="" out pid name="" hp="" ip=""
    target="$(adb mdns services 2>/dev/null | awk -v s="$svc" '$0 ~ s {print $3; exit}')"
    if [[ -n "$target" ]]; then echo "$target"; return; fi
    command -v dns-sd >/dev/null || return 0

    out="$(mktemp)"
    dns-sd -B "$svc" local. >"$out" 2>/dev/null & pid=$!
    for _ in {1..30}; do
        name="$(awk -v s="$svc." '$2=="Add" && $6==s {print $NF; exit}' "$out")"
        [[ -n "$name" ]] && break
        sleep 0.1
    done
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true

    if [[ -n "$name" ]]; then
        dns-sd -L "$name" "$svc" local. >"$out" 2>/dev/null & pid=$!
        for _ in {1..30}; do
            # line: "... can be reached at Android.local.:42389 (interface 14)"
            hp="$(awk '/can be reached at/ {print $(NF-2); exit}' "$out")"
            [[ -n "$hp" ]] && break
            sleep 0.1
        done
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
    fi
    rm -f "$out"
    [[ -z "$hp" ]] && return 0

    ip="$(dscacheutil -q host -a name "${hp%:*}" | awk '/^ip_address/ {print $2; exit}')"
    [[ -n "$ip" ]] && echo "$ip:${hp##*:}"
}

rotation_mode=""
show_video=false
scrcpy_args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        pair|--pair)
            echo "Searching for phone with 'Pair device with pairing code' popup open..."
            pair_target=""
            for _ in 1 2 3 4 5; do
                pair_target="$(find_service _adb-tls-pairing._tcp)"
                [[ -n "$pair_target" ]] && break
                sleep 1
            done
            if [[ -z "$pair_target" ]]; then
                echo "Could not auto-discover pairing popup via mDNS."
                echo "Make sure the 'Pair device with pairing code' dialog is open on your phone, or run: adb pair <IP:PORT>"
                exit 1
            fi
            echo "Found pairing service at $pair_target"
            adb pair "$pair_target"
            shift
            ;;
        -v|--video)
            show_video=true
            shift
            ;;
        -l|--landscape)
            rotation_mode="1"
            shift
            ;;
        -rl|--rev-landscape|--reverse-landscape)
            rotation_mode="3"
            shift
            ;;
        -p|--portrait)
            rotation_mode="0"
            shift
            ;;
        *)
            if [[ "$1" == *:* && "$1" != -* ]]; then
                echo "Connecting to $1..."
                adb connect "$1"
            else
                scrcpy_args+=("$1")
            fi
            shift
            ;;
    esac
done

# Find an attached physical/wireless phone (ignoring Android Studio emulators)
get_phone_serial() {
    adb devices | awk 'NR>1 && $2=="device" && $1 !~ /^emulator-/ {print $1; exit}'
}

serial="$(get_phone_serial)"

# If not connected yet, auto-discover via Android Wireless Debugging mDNS
# Retry up to 4 seconds in case `adb start-server` just cold-started the daemon
if [[ -z "$serial" ]]; then
    # Drop stale entries left from an old port so they don't pile up as "offline"
    adb devices | awk 'NR>1 && $2=="offline" {print $1}' | while read -r s; do adb disconnect "$s" >/dev/null 2>&1 || true; done
    for _ in 1 2 3 4; do
        serial="$(get_phone_serial)"
        [[ -n "$serial" ]] && break
        target="$(find_service _adb-tls-connect._tcp)"
        if [[ -n "$target" ]]; then
            echo "Discovered phone via mDNS at $target, connecting..."
            adb connect "$target" >/dev/null 2>&1 || true
            sleep 0.5
            serial="$(get_phone_serial)"
            [[ -n "$serial" ]] && break
        fi
        sleep 1
    done
fi

if [[ -z "$serial" ]]; then
    echo "No Android phone detected."
    echo "Make sure 'Wireless debugging' is ON (or plug in via USB), or run: phone <IP:PORT>"
    exit 1
fi

# Optional: Force Android device screen orientation & restore when scrcpy exits
if [[ -n "$rotation_mode" ]]; then
    orig_rot="$(adb -s "$serial" shell wm user-rotation 2>/dev/null | tr -d '\r')"
    restore_rotation() {
        echo "Restoring phone orientation..."
        adb -s "$serial" shell wm set-ignore-orientation-request false >/dev/null 2>&1 || true
        if [[ "$orig_rot" == free* ]]; then
            adb -s "$serial" shell wm user-rotation free >/dev/null 2>&1 || true
        else
            local rot_val="${orig_rot##* }"
            adb -s "$serial" shell wm user-rotation lock "${rot_val:-0}" >/dev/null 2>&1 || true
        fi
    }
    trap restore_rotation EXIT INT TERM

    echo "Forcing phone orientation (rotation=$rotation_mode)..."
    adb -s "$serial" shell wm set-ignore-orientation-request true >/dev/null 2>&1 || true
    adb -s "$serial" shell wm user-rotation lock "$rotation_mode" >/dev/null 2>&1 || true
fi

video_flags=()
if [[ "$show_video" != true ]]; then
    video_flags+=("--no-video")
fi

echo "Connected to $serial — launching scrcpy mouse & keyboard control (press Left Option to release cursor)..."
scrcpy -s "$serial" ${video_flags[@]+"${video_flags[@]}"} -KM ${scrcpy_args[@]+"${scrcpy_args[@]}"}
