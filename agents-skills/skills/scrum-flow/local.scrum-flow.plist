<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.scrum-flow</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/tnkapdy/.dotfiles/agents-skills/skills/scrum-flow/post-standup.sh</string>
  </array>

  <!-- Every day 10:00. Omitting Weekday means all seven days.
       If the Mac is asleep at 10:00, launchd runs the job once it wakes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/scrum-flow.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/scrum-flow.err</string>
</dict>
</plist>
